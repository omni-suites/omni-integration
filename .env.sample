# Local / compose sample for omni-integration
PORT=3003

# Same postgres-db container as apps stack, separate database
DATABASE_URL=postgresql://user:password@localhost:5432/omni_integration_db?schema=public

# Linear (webhook → this service)
LINEAR_WEBHOOK_SECRET=
# Prefer ID (stable); name is fine for PoC — you own exact spelling
LINEAR_PROJECT_ID=
LINEAR_PROJECT_NAME=omni-suites
LINEAR_READY_LABEL=ready-for-tc

# Squash TM REST (path includes /squash)
# Docker network: http://squash-tm:8080/squash
# Public:       https://squash-tcms.test-suites-poc.work.gd/squash
SQUASH_BASE_URL=http://localhost:8080/squash
SQUASH_API_TOKEN=
# Or basic auth instead of token:
SQUASH_USER=
SQUASH_PASSWORD=
SQUASH_PROJECT_ID=
SQUASH_PROJECT_NAME=omni-suites
